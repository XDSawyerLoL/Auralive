AURA_CLOUD_BASE_URL=https://your-aura-cloud.example
AURA_CLOUD_TOKEN=
AURA_RUNTIME_MODEL=qwen3:8b
AURA_RUNTIME_OLLAMA_URL=http://127.0.0.1:11434
AURA_RUNTIME_POLL_SECONDS=1.5
AURA_RUNTIME_HEARTBEAT_SECONDS=15
AURA_RUNTIME_TIMEOUT_SECONDS=95
AURA_RUNTIME_IDENTITY_FILE=./data/aura-runtime-node-id
AURA_COMPUTE_MESH_CONSENT=false
AURA_RUNTIME_MOA_ENABLED=false
AURA_RUNTIME_DATA_DIR=./data
AURA_RUNTIME_GITHUB_REPOSITORY=XDSawyerLoL/Auralive
AURA_RUNTIME_GITHUB_ALLOWED_REPOSITORIES=XDSawyerLoL/Auralive,XDSawyerLoL/QuanticSillage,XDSawyerLoL/QuanticMail,XDSawyerLoL/QUANTIC-OS,XDSawyerLoL/Quantic-Browser,XDSawyerLoL/Human-Agency-Engine
AURA_RUNTIME_GITHUB_TOKEN=
AURA_RUNTIME_EVOLUTION_AUTO_SUBMIT=true

# AURA Runtime Operator — autonome sans Quantic Studio.
# Plusieurs racines: séparer par virgule (ou ; si nécessaire).
AURA_RUNTIME_OPERATOR_ROOTS=.
AURA_RUNTIME_OPERATOR_ALLOWED_RISKS=safe,ai,network,local-write,process,local-control
# Aucun shell n'est utilisé; seules ces commandes directes sont acceptées.
AURA_RUNTIME_OPERATOR_COMMANDS=git,python,python3,node,npm,npx,pytest,cargo
AURA_RUNTIME_OPERATOR_DOMAINS=api.github.com,github.com,pypi.org,registry.npmjs.org
AURA_RUNTIME_OPERATOR_MAX_FILE_BYTES=200000
AURA_RUNTIME_OPERATOR_PROCESS_TIMEOUT_SECONDS=90
AURA_RUNTIME_OPERATOR_HTTP_TIMEOUT_SECONDS=20
