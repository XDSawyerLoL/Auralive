# AURA Cloud / Hostinger — exemple sans secrets
AURA_HOST=0.0.0.0
AURA_PORT=8787
AURA_PUBLIC_BASE_URL=https://antiquewhite-dolphin-780448.hostingersite.com

# Noyau cognitif unifie
AURA_COGNITIVE_ENABLED=true
AURA_COGNITIVE_TICK_SECONDS=30
AURA_COGNITIVE_REFLECTION_SECONDS=300
AURA_COGNITIVE_MAX_REFLECTIONS_PER_HOUR=6
AURA_COGNITIVE_OPERATOR_ALLOWED_RISKS=safe,ai
AURA_CLOUD_TOKEN=REMPLACE_PAR_UN_SECRET_LONG

# Centre de commande autonome Quantic Sillage
AURA_COMMAND_CENTER_ENABLED=true
AURA_COMMAND_CENTER_AUTO_EXECUTE=true
AURA_COMMAND_CENTER_TICK_SECONDS=60
AURA_COMMAND_CENTER_WARMUP_SECONDS=20
AURA_COMMAND_CENTER_MAX_INITIATIVES_PER_HOUR=4
AURA_COMMAND_CENTER_COOLDOWN_SECONDS=1800
AURA_COMMAND_CENTER_MIN_CONFIDENCE=0.66
AURA_COMMAND_CENTER_ALLOWED_RISKS=safe,ai,local-control,local-write
AURA_COMMAND_CENTER_FLEET_POLL_SECONDS=1200
AURA_COMMAND_CENTER_REQUEST_TIMEOUT_MS=9000
# Jeton machine GitHub optionnel mais nécessaire pour relancer un CI ou ouvrir un ticket.
# Sans jeton, AURA surveille les dépôts publics et planifie, mais n'écrit pas sur GitHub.
AURA_COMMAND_GITHUB_TOKEN=
AURA_COMMAND_GITHUB_REPOS=XDSawyerLoL/Auralive,XDSawyerLoL/QuanticSillage,XDSawyerLoL/QuanticMail,XDSawyerLoL/QUANTIC-OS,XDSawyerLoL/Quantic-Browser,XDSawyerLoL/Human-Agency-Engine
AURA_COMMAND_AUTO_RERUN_FAILED_CI=true
AURA_COMMAND_AUTO_CREATE_FAILURE_ISSUE=true
AURA_COMMAND_MAX_GITHUB_ACTIONS_PER_CYCLE=2


# Web Substrate / méta-raisonnement.
# Sans moteur de recherche externe, AURA dispose déjà des API Wikipedia + Crossref.
# Pour le Web général, brancher un endpoint SearXNG JSON compatible.
AURA_WEB_SUBSTRATE_ENABLED=true
AURA_WEB_SEARCH_URL=
AURA_WEB_SEARCH_API_KEY=
AURA_WEB_SEARCH_LANGUAGE=fr-FR
AURA_WEB_SEARCH_RESULTS=8
AURA_WEB_MAX_QUERIES=3
AURA_WEB_MAX_SOURCES=8
AURA_WEB_MAX_SOURCE_BYTES=240000
AURA_WEB_REQUEST_TIMEOUT_MS=12000
AURA_WEB_MEMORY_TTL_SECONDS=604800
# Vide = Web public HTTPS autorisé, avec blocage SSRF des réseaux privés.
AURA_WEB_ALLOWED_DOMAINS=
AURA_WEB_BLOCKED_DOMAINS=localhost,metadata.google.internal,169.254.169.254

# AURA Fabric 2.0 — Internet comme bus de capacités typées.
AURA_FABRIC_ENABLED=true
# Exemples: https://aura-edge.example.workers.dev
AURA_FABRIC_DISCOVERY_URLS=
AURA_FABRIC_TOKEN=
AURA_FABRIC_REQUEST_TIMEOUT_MS=15000
AURA_FABRIC_DISCOVERY_SECONDS=900
AURA_FABRIC_MAX_REMOTE_CAPABILITIES=64
AURA_FABRIC_REMOTE_TRUST_CEILING=0.78
AURA_FABRIC_MAX_GRAPH_NODES=32
AURA_FABRIC_MAX_PARALLEL=12
# 0 = pas de plafond monétaire tant que les capabilities déclarent coût=0.
AURA_FABRIC_DEFAULT_BUDGET_MICROUNITS=0

# AURA Compute Mesh 2.1 — calcul distribué volontaire et borné.
AURA_COMPUTE_MESH_ENABLED=true
AURA_COMPUTE_MESH_PUBLIC_JOIN=false
AURA_COMPUTE_MESH_PEER_TTL_SECONDS=120
AURA_COMPUTE_MESH_HEARTBEAT_SECONDS=20
AURA_COMPUTE_MESH_CLEANUP_SECONDS=45
AURA_COMPUTE_MESH_LEASE_SECONDS=45
AURA_COMPUTE_MESH_MAX_REPLICAS=5
AURA_COMPUTE_MESH_MAX_TASK_MS=60000
AURA_COMPUTE_MESH_MAX_PAYLOAD_BYTES=65536
AURA_COMPUTE_MESH_MAX_RESULT_BYTES=262144
# Runtime WebGPU navigateur optionnel; épingler/auto-héberger le module avant ouverture publique.
# Exemple de test (préférer un bundle auto-hébergé et vérifié en production):
# AURA_MESH_WEBLLM_MODULE_URL=https://cdn.jsdelivr.net/npm/@mlc-ai/web-llm@0.2.85/+esm
AURA_MESH_WEBLLM_MODULE_URL=
AURA_MESH_WEBLLM_MODEL=
# JSON: {"release-key":"-----BEGIN PUBLIC KEY-----\\n..."}
AURA_WASM_SIGNER_KEYS_JSON={}
AURA_WASM_KERNEL_MAX_BYTES=2097152

# AURA Evolution Phase 3
AURA_EVOLUTION_ENABLED=true
AURA_EVOLUTION_INTERVAL_SECONDS=21600
AURA_EVOLUTION_AUTO_SUBMIT=true
AURA_EVOLUTION_AUTO_MERGE=true
AURA_EVOLUTION_GITHUB_MACHINE_TOKEN=
AURA_EVOLUTION_GITHUB_REPOSITORY=XDSawyerLoL/Auralive
AURA_EVOLUTION_GITHUB_BASE_BRANCH=main
AURA_EVOLUTION_ALLOWED_DOMAINS=api.github.com,pypi.org
AURA_EVOLUTION_RESEARCH_URLS=
AURA_EVOLUTION_REQUIRED_CHECKS=gate-node-cloud,gate-python-core,gate-rust-core,gate-fabric-rust,gate-windows-smoke
AURA_EVOLUTION_CANARY_REQUIRED=true
AURA_EVOLUTION_CANARY_TOKEN=REMPLACE_PAR_UN_AUTRE_SECRET_LONG
AURA_EVOLUTION_CANARY_MIN_OBSERVATIONS=3

# HORIZON — laisser off tant que l'URL/API key ne sont pas renseignees
HORIZON_ENABLED=false
HORIZON_BASE_URL=
HORIZON_API_KEY=
HORIZON_EXTERNAL_ID=aura-cloud
HORIZON_POLL_SECONDS=60
HORIZON_TIMEZONE=Europe/Paris

# Serveur cloud: aucun moteur de diffusion Windows/OBS
AURA_BROADCAST_ENGINE=obs
AURA_NATIVE_ENGINE_AUTOSTART=false
OBS_AUTO_CONNECT=false
OBS_DISCOVER_LOCAL=false
OBS_ENABLED=false
LIVE_VISION_ENABLED=false

# IA: a adapter au fournisseur disponible sur le serveur
AI_MODE=off
AI_BASE_URL=http://localhost:11434
AI_MODEL=gemma3:12b
AI_API_KEY=

# Donnees persistantes
DATABASE_PATH=data/aura_live.db
MEDIA_DIR=data/media
LOG_LEVEL=INFO

# Résilience Cloud
AURA_BACKUP_INTERVAL_SECONDS=21600
AURA_BACKUP_RETENTION_COUNT=28
AURA_METRICS_ROLLUP_SECONDS=300
