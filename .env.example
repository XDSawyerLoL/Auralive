# Serveur local
AURA_HOST=127.0.0.1
AURA_PORT=8787
AURA_PUBLIC_BASE_URL=http://localhost:8787

# Twitch Developer Console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:8787/auth/callback

# Comptes Twitch
TWITCH_BROADCASTER_LOGIN=sansahd
TWITCH_BOT_LOGIN=mairaiy

# Intelligence artificielle locale : aucun abonnement ni cle requis.
# Modes disponibles : off | ollama | gemini | openai_compatible
AI_MODE=ollama
AI_BASE_URL=http://localhost:11434
AI_MODEL=gemma3:12b
AI_FAST_MODEL=
# Priorite a la qualite de conversation. Les automatisations peuvent toujours
# definir explicitement un modele plus leger si necessaire.
AI_AUTO_FAST_MODEL=false
AI_REQUEST_TIMEOUT_SECONDS=45
AI_WARMUP_TIMEOUT_SECONDS=20
AI_FAILURE_COOLDOWN_SECONDS=60
AI_RETRY_ON_TIMEOUT=true
AI_CHAT_MAX_TOKENS=90
AI_CONTEXT_MESSAGES=4
AI_CONTEXT_WINDOW=4096
AI_KEEP_ALIVE=30m
AI_TEMPERATURE=0.78
AI_WARMUP_ENABLED=true
AI_TIMEOUT_SECONDS=120

# Constellation locale AURA : plusieurs modèles installés peuvent coopérer.
# Le routeur choisit selon la tâche, la latence et le coût; AURA reste le cerveau.
AI_CONSTELLATION_ENABLED=true
AI_CONSTELLATION_MULTI_REVIEW=true
AI_CONSTELLATION_REVIEW_MIN_TOKENS=220
AI_CONSTELLATION_MAX_MODELS=2
# Modèles locaux utiles (installation volontaire depuis http://localhost:8787/models) :
# gpt-oss:20b          -> raisonnement / outils (Apache-2.0)
# deepseek-r1:8b       -> raisonnement / critique (MIT pour R1; vérifier le dérivé exact)
# dolphin-mistral:7b   -> conversation / empathie (Apache-2.0)
# qwen3:8b             -> polyvalent / code / outils (licence du tag officiel)
# hermes3:8b           -> agentique, mais licence communautaire Llama
# Aucun modèle multi-Go n'est téléchargé automatiquement au premier lancement.
# Optionnel : cle Gemini ou fournisseur compatible. Jamais dans GitHub.
AI_API_KEY=
AI_SPONTANEOUS_ENABLED=false
AI_SPONTANEOUS_CHANCE=0.02
AI_COOLDOWN_SECONDS=35

# Génération d'images locale. "auto" détecte Forge/A1111 puis ComfyUI.
# FLUX.1-schnell ou Qwen-Image peuvent être utilisés avec un backend compatible.
AURA_IMAGE_MODE=auto
AURA_IMAGE_A1111_URL=http://127.0.0.1:7860
AURA_IMAGE_COMFY_URL=http://127.0.0.1:8188
AURA_IMAGE_OUTPUT_DIR=data/generated-images
AURA_IMAGE_WIDTH=1024
AURA_IMAGE_HEIGHT=1024
AURA_IMAGE_STEPS=8
AURA_IMAGE_MODEL=FLUX.1-schnell
AURA_IMAGE_COMFY_WORKFLOW=config/comfyui-aura-workflow.json

# Voix principale de Mairaiy : Kokoro ONNX local, voix francaise ff_siwis.
# Le package Windows livre le modele et le pack de voix : pas de quota, pas de cle API.
MAIRAIY_VOICE_LOCKED=true
MAIRAIY_KOKORO_PRIMARY=true
MAIRAIY_KOKORO_ENABLED=true
MAIRAIY_KOKORO_VOICE=ff_siwis
MAIRAIY_KOKORO_LANGUAGE=fr-fr
MAIRAIY_KOKORO_SPEED=1.0
MAIRAIY_KOKORO_DIR=data/voices/kokoro
MAIRAIY_KOKORO_MODEL=data/voices/kokoro/kokoro-v1.0.onnx
MAIRAIY_KOKORO_VOICES=data/voices/kokoro/voices-v1.0.bin
MAIRAIY_KOKORO_AUTO_DOWNLOAD=true

# Secours premium optionnel : Gemini TTS avec Aoede.
# Si aucune cle n'est fournie, Aura reste simplement sur Kokoro local.
TTS_MODE=gemini
TTS_MODEL=gemini-3.1-flash-tts-preview
TTS_VOICE=Aoede
MAIRAIY_GEMINI_VOICE=Aoede
MAIRAIY_LOCKED_VOICE=Aoede
TTS_API_KEY=
MAIRAIY_GEMINI_429_COOLDOWN_SECONDS=21600

# Dernier secours gratuit et hors ligne : Piper.
MAIRAIY_PIPER_FALLBACK_ENABLED=true
MAIRAIY_LOCAL_VOICE_ENABLED=true
MAIRAIY_LOCAL_VOICE=fr_FR-siwis-medium
MAIRAIY_LOCAL_VOICE_DIR=data/voices/piper
MAIRAIY_LOCAL_VOICE_AUTO_DOWNLOAD=true
MAIRAIY_LOCAL_VOICE_SPEED=1.0
MAIRAIY_LOCAL_NOISE_SCALE=0.62
MAIRAIY_LOCAL_NOISE_W_SCALE=0.78
MAIRAIY_FORCE_LOCAL_VOICE=false
# Ne jamais basculer vers une voix Windows/navigateur aleatoire.
TTS_ALLOW_VOICE_FALLBACK=false

# Le budget Gemini ne s'applique que si Gemini est volontairement configure.
TTS_BUDGET_ENABLED=true
TTS_MAX_DAILY_USD=0.50

# Dialogue vocal depuis http://localhost:8787/voice-control
# Edge/Chrome transcrit directement en continu. Le modele ci-dessous reste disponible pour le mode WAV de secours.
VOICE_INPUT_ENABLED=true
VOICE_INPUT_MODEL=gemini-3.5-flash-lite
VOICE_INPUT_MAX_SECONDS=20

# Perception proche du direct : captures locales frequentes, analyse Gemini seulement si l'image change.
LIVE_VISION_ENABLED=true
LIVE_VISION_CAPTURE_SECONDS=8
LIVE_VISION_ANALYSIS_COOLDOWN_SECONDS=30
LIVE_VISION_CHANGE_THRESHOLD=0.18
LIVE_VISION_MAX_ANALYSES_PER_HOUR=40
LIVE_VISION_MAX_REACTIONS_PER_HOUR=5
LIVE_VISION_REACTION_COOLDOWN_SECONDS=75

# Accueil des personnes visibles dans le chat Twitch.
WELCOME_ARRIVALS_ENABLED=true
WELCOME_ARRIVALS_POLL_SECONDS=45
WELCOME_ARRIVALS_COOLDOWN_SECONDS=90
WELCOME_ARRIVALS_MAX_PER_STREAM=12
WELCOME_ARRIVALS_BATCH_SIZE=3

# Noyau souverain AURA unifié
# Active Soul, réflexion ambient, apprentissage par résultats, routines et agents.
AURA_COGNITIVE_ENABLED=true
AURA_COGNITIVE_TICK_SECONDS=30
AURA_COGNITIVE_REFLECTION_SECONDS=300
AURA_COGNITIVE_MAX_REFLECTIONS_PER_HOUR=6
# Jeton privé partagé avec AURA Cloud. Le même jeton autorise Quantic Studio
# à devenir le worker local d'AURA sans exposer de port entrant sur le PC.
AURA_CLOUD_TOKEN=
AURA_CLOUD_BASE_URL=https://antiquewhite-dolphin-780448.hostingersite.com
AURA_CLOUD_WORKER_ENABLED=true
AURA_CLOUD_WORKER_POLL_SECONDS=1.5
AURA_CLOUD_WORKER_HEARTBEAT_SECONDS=15
AURA_CLOUD_WORKER_TIMEOUT_SECONDS=95

# Centre de commande Quantic Sillage.
# Le Cloud surveille en continu l'état interne et la santé GitHub de la flotte.
AURA_COMMAND_CENTER_ENABLED=true
AURA_COMMAND_CENTER_AUTO_EXECUTE=true
AURA_COMMAND_CENTER_TICK_SECONDS=60
AURA_COMMAND_CENTER_FLEET_POLL_SECONDS=1200
AURA_COMMAND_CENTER_MAX_INITIATIVES_PER_HOUR=4
AURA_COMMAND_CENTER_COOLDOWN_SECONDS=1800
AURA_COMMAND_CENTER_MIN_CONFIDENCE=0.66
AURA_COMMAND_CENTER_ALLOWED_RISKS=safe,ai,local-control,local-write
AURA_COMMAND_GITHUB_TOKEN=
AURA_COMMAND_GITHUB_REPOS=XDSawyerLoL/Auralive,XDSawyerLoL/QuanticSillage,XDSawyerLoL/QuanticMail,XDSawyerLoL/QUANTIC-OS,XDSawyerLoL/Quantic-Browser,XDSawyerLoL/Human-Agency-Engine
AURA_COMMAND_AUTO_RERUN_FAILED_CI=true
AURA_COMMAND_AUTO_CREATE_FAILURE_ISSUE=true

# Bras opérateur local. Le Centre de commande Cloud peut demander des actions,
# mais ne peut jamais élargir cette politique configurée sur Quantic Studio.
AURA_COGNITIVE_OPERATOR_ALLOWED_RISKS=safe,ai,network,local-write,process,twitch-write,obs-write,moderation,local-control

# AURA Evolution — Phase 3 autonome.
# Le package embarque app/, tests/ et cloud-node/ dans le sas source.
# Toute promotion code passe par tests locaux, CI complète et canary.
AURA_EVOLUTION_ENABLED=true
AURA_EVOLUTION_INTERVAL_SECONDS=21600
AURA_EVOLUTION_AUTO_SUBMIT=true
AURA_EVOLUTION_AUTO_MERGE=true
AURA_EVOLUTION_GITHUB_MACHINE_TOKEN=
# Compatibilité ancienne variable (optionnelle)
AURA_EVOLUTION_GITHUB_TOKEN=
AURA_EVOLUTION_GITHUB_REPOSITORY=XDSawyerLoL/Auralive
AURA_EVOLUTION_GITHUB_BASE_BRANCH=main
AURA_EVOLUTION_ALLOWED_DOMAINS=api.github.com,pypi.org
AURA_EVOLUTION_RESEARCH_URLS=
AURA_EVOLUTION_REQUIRED_CHECKS=gate-node-cloud,gate-python-core,gate-rust-core,gate-fabric-rust,gate-windows-smoke
# Canary automatique après sandbox + CI; mode manuel disponible si nécessaire.
AURA_EVOLUTION_CANARY_REQUIRED=true
AURA_EVOLUTION_CANARY_MODE=automatic
AURA_EVOLUTION_CANARY_TOKEN=
AURA_EVOLUTION_CANARY_MIN_OBSERVATIONS=3

# Fusion cognitive AURA <-> HORIZON
# Active le moteur d'anticipation du monde dans AURA. Le fonctionnement local d'AURA
# reste disponible si HORIZON est hors ligne.
HORIZON_ENABLED=false
HORIZON_BASE_URL=
HORIZON_API_KEY=
HORIZON_EXTERNAL_ID=aura-local
HORIZON_POLL_SECONDS=60
HORIZON_REQUEST_TIMEOUT_SECONDS=8
HORIZON_EVENT_LIMIT=100
HORIZON_CANDIDATE_LIMIT=100
HORIZON_FORECAST_LIMIT=100
HORIZON_AI_CONTEXT_SIGNALS=10
HORIZON_COUNTRY=FR
HORIZON_CURRENCY=EUR
HORIZON_TIMEZONE=Europe/Paris

# OBS WebSocket (OBS 28+)
# Aura lit automatiquement le port et le mot de passe du OBS local sur Windows.
OBS_AUTO_CONNECT=true
OBS_DISCOVER_LOCAL=true
OBS_ENABLED=false
OBS_HOST=127.0.0.1
OBS_PORT=
OBS_PASSWORD=

# Moteur de diffusion
# obs = compatibilité historique via OBS WebSocket
# native = moteur Rust Quantic Studio Core intégré
AURA_BROADCAST_ENGINE=native
AURA_NATIVE_ENGINE_AUTOSTART=true
# Laisser vide si QuanticStudioCore.exe est à côté de QuanticStudio.exe.
AURA_NATIVE_ENGINE_EXE=

# Reglages generaux
DATABASE_PATH=data/aura_live.db
LOG_LEVEL=INFO

# Optionnel : recherche YouTube avancee pour Song Request
YOUTUBE_API_KEY=
MEDIA_DIR=data/media


# AURA Compute Mesh v0.1 — partage de calcul volontaire uniquement.
# Laisser false tant que cette machine ne doit pas accepter de tâches du maillage.
AURA_COMPUTE_MESH_CONSENT=false
AURA_COMPUTE_MESH_IDENTITY_FILE=data/compute-mesh-node-id


# AURA Peer Mesh v0.2 — le navigateur local devient un pair WebRTC/WebGPU.
# Nécessite AURA_COMPUTE_MESH_CONSENT=true.
AURA_MESH_P2P_ENABLED=true
