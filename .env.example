# Serveur local
AURA_HOST=127.0.0.1
AURA_PORT=8787
AURA_PUBLIC_BASE_URL=http://localhost:8787

# Twitch Developer Console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:8787/auth/callback

# Comptes Twitch
TWITCH_BROADCASTER_LOGIN=sansahd
TWITCH_BOT_LOGIN=mairaiy

# Intelligence artificielle : off | ollama | gemini | openai_compatible
AI_MODE=off
# Ollama : http://localhost:11434
# Gemini : https://generativelanguage.googleapis.com/v1beta
AI_BASE_URL=http://localhost:11434
# Ollama : gemma3:12b
# Gemini conseillé pour Twitch : gemini-3.5-flash-lite
AI_MODEL=gemma3:12b
# Optionnel : modèle plus rapide réservé aux réponses Twitch
AI_FAST_MODEL=
# Détection automatique d'un modèle Ollama plus léger déjà installé
AI_AUTO_FAST_MODEL=true
# Une réponse Twitch ne doit pas monopoliser le bot pendant deux minutes
AI_REQUEST_TIMEOUT_SECONDS=45
AI_WARMUP_TIMEOUT_SECONDS=20
AI_FAILURE_COOLDOWN_SECONDS=60
AI_RETRY_ON_TIMEOUT=true
AI_CHAT_MAX_TOKENS=90
AI_CONTEXT_MESSAGES=4
AI_CONTEXT_WINDOW=4096
AI_KEEP_ALIVE=30m
AI_TEMPERATURE=0.78
AI_WARMUP_ENABLED=true
AI_TIMEOUT_SECONDS=120
# Clé Gemini ou clé du fournisseur OpenAI-compatible. Jamais dans GitHub.
AI_API_KEY=
AI_SPONTANEOUS_ENABLED=false
AI_SPONTANEOUS_CHANCE=0.02
AI_COOLDOWN_SECONDS=35

# Voix publique de Mairaiy : une seule identité vocale, jamais remplacée automatiquement
TTS_MODE=gemini
TTS_MODEL=gemini-3.1-flash-tts-preview
TTS_VOICE=Leda
MAIRAIY_VOICE_LOCKED=true
MAIRAIY_LOCKED_VOICE=Leda
# false = pas de voix Windows/navigateur si Gemini échoue ou si le budget est atteint
TTS_ALLOW_VOICE_FALLBACK=false
# Plafond conservateur au tarif payant. Une fois atteint, Mairaiy reste silencieuse plutôt que de changer de voix.
TTS_BUDGET_ENABLED=true
TTS_MAX_DAILY_USD=0.50
# TTS_API_KEY= peut utiliser une clé séparée; vide = réutilise AI_API_KEY.
TTS_API_KEY=

# Dialogue vocal depuis http://localhost:8787/voice-control
# Edge/Chrome transcrit directement en continu. Le modèle ci-dessous reste disponible pour le mode WAV de secours.
VOICE_INPUT_ENABLED=true
VOICE_INPUT_MODEL=gemini-3.5-flash-lite
VOICE_INPUT_MAX_SECONDS=20

# Perception proche du direct : captures locales fréquentes, analyse Gemini seulement si l'image change
LIVE_VISION_ENABLED=true
LIVE_VISION_CAPTURE_SECONDS=8
LIVE_VISION_ANALYSIS_COOLDOWN_SECONDS=30
LIVE_VISION_CHANGE_THRESHOLD=0.18
LIVE_VISION_MAX_ANALYSES_PER_HOUR=40
LIVE_VISION_MAX_REACTIONS_PER_HOUR=5
LIVE_VISION_REACTION_COOLDOWN_SECONDS=75

# Accueil des personnes visibles dans le chat Twitch
# Nécessite de reconnecter SANSAHD pour le scope moderator:read:chatters
WELCOME_ARRIVALS_ENABLED=true
WELCOME_ARRIVALS_POLL_SECONDS=45
WELCOME_ARRIVALS_COOLDOWN_SECONDS=90
WELCOME_ARRIVALS_MAX_PER_STREAM=12
WELCOME_ARRIVALS_BATCH_SIZE=3

# OBS WebSocket (OBS 28+)
OBS_ENABLED=false
OBS_HOST=127.0.0.1
OBS_PORT=4455
OBS_PASSWORD=

# Réglages généraux
DATABASE_PATH=data/aura_live.db
LOG_LEVEL=INFO

# Optionnel : recherche YouTube avancée pour Song Request
YOUTUBE_API_KEY=
MEDIA_DIR=data/media
