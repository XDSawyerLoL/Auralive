NODE_ENV=production
HOST=0.0.0.0
PORT=3000
AURA_PUBLIC_BASE_URL=https://antiquewhite-dolphin-780448.hostingersite.com

# MySQL Hostinger
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Alternative: DATABASE_URL=mysql://user:password@localhost:3306/database
AURA_BACKUP_INTERVAL_SECONDS=21600
AURA_BACKUP_RETENTION_COUNT=28
AURA_METRICS_ROLLUP_SECONDS=300

# Secrets distincts
AURA_CLOUD_TOKEN=CHANGE_ME_LONG_RANDOM_SECRET
AURA_EVOLUTION_CANARY_TOKEN=

# Couche de langage. AURA pense sans LLM.
# Quantic Studio local est prioritaire; Gemini peut rester un secours transitoire.
# Mettre AI_MODE=bridge pour supprimer totalement le secours cloud.
AURA_LOCAL_AI_PREFERRED=true
# Modes: off | bridge | gemini | openai_compatible | ollama
AI_MODE=off
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_MS=45000
AI_TEMPERATURE=0.65

# Soul / cognition
AURA_COGNITIVE_ENABLED=true
AURA_COGNITIVE_TICK_SECONDS=30
AURA_COGNITIVE_REFLECTION_SECONDS=300
AURA_COGNITIVE_MAX_REFLECTIONS_PER_HOUR=6

# Pont sortant Quantic Studio. Par défaut il réutilise AURA_CLOUD_TOKEN.
AURA_BRIDGE_LEASE_SECONDS=90
AURA_BRIDGE_WORKER_ONLINE_MS=45000
AURA_BRIDGE_OPERATOR_WAIT_MS=18000
AURA_BRIDGE_INFERENCE_TIMEOUT_MS=90000
AURA_BRIDGE_VOICE_TIMEOUT_MS=60000
AURA_BRIDGE_IMAGE_TIMEOUT_MS=300000
AURA_BRIDGE_OPERATOR_MAX_STEPS=6

# HORIZON
HORIZON_ENABLED=false
HORIZON_BASE_URL=
HORIZON_API_KEY=
HORIZON_EXTERNAL_ID=aura-cloud
HORIZON_POLL_SECONDS=60
HORIZON_COUNTRY=FR
HORIZON_CURRENCY=EUR
HORIZON_TIMEZONE=Europe/Paris

# Evolution autonome Phase 3
AURA_EVOLUTION_ENABLED=true
AURA_EVOLUTION_INTERVAL_SECONDS=21600
AURA_EVOLUTION_GITHUB_REPOSITORY=XDSawyerLoL/Auralive
AURA_EVOLUTION_GITHUB_BASE_BRANCH=main
AURA_EVOLUTION_ALLOWED_DOMAINS=api.github.com,registry.npmjs.org
AURA_EVOLUTION_RESEARCH_URLS=
AURA_EVOLUTION_CANARY_REQUIRED=true\nAURA_EVOLUTION_CANARY_MODE=automatic
AURA_EVOLUTION_CANARY_MIN_OBSERVATIONS=3

# Voix Mairaiy Cloud — fonctionne directement depuis le site, Quantic Studio devient optionnel
MAIRAIY_CLOUD_VOICE_ENABLED=true
TTS_API_KEY=
TTS_BASE_URL=https://generativelanguage.googleapis.com/v1beta
TTS_MODEL=gemini-3.1-flash-tts-preview
TTS_VOICE=Leda
TTS_TIMEOUT_MS=35000
