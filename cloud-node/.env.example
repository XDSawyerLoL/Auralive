NODE_ENV=production
HOST=0.0.0.0
PORT=3000
# Hard financial invariant: no remote model/TTS/expert call that can create usage charges.
AURA_ZERO_COST_MODE=true
# Autorise Gemini uniquement si CETTE clé/projet est bien sur le niveau gratuit.
# Laisser false en cas de doute. Les appels restent plafonnés quotidiennement.
AURA_GEMINI_FREE_TIER_CONFIRMED=false
AURA_GEMINI_FREE_TIER_TEXT_MAX_PER_DAY=45
AURA_GEMINI_FREE_TIER_VOICE_MAX_PER_DAY=60
AURA_PUBLIC_BASE_URL=https://antiquewhite-dolphin-780448.hostingersite.com
AURA_PUBLIC_CHAT_RATE_LIMIT_MAX=20
AURA_PUBLIC_CHAT_RATE_LIMIT_WINDOW_SECONDS=60
AURA_AUTH_RATE_LIMIT_MAX=8
AURA_AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AURA_TRUST_PROXY_HOPS=1

# Canaux de téléchargement Quantic Glide exposés par AURA.
# Laisser vide pour utiliser les URLs officielles par défaut.
AURA_GLIDE_WINDOWS_URL=
AURA_GLIDE_ANDROID_URL=

# MySQL Hostinger
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Alternative: DATABASE_URL=mysql://user:password@localhost:3306/database
AURA_BACKUP_INTERVAL_SECONDS=21600
AURA_BACKUP_RETENTION_COUNT=28
AURA_METRICS_ROLLUP_SECONDS=300

# Secrets serveur distincts.
# AURA_CLOUD_TOKEN est OPTIONNEL pour ouvrir l'interface et discuter avec AURA.
# Le définir uniquement si les endpoints privés d'administration / bridge sont utilisés.
# Il n'est jamais demandé dans le navigateur.
AURA_CLOUD_TOKEN=
AURA_EVOLUTION_CANARY_TOKEN=

# Couche de langage. AURA pense sans LLM.
# AURA Runtime/local mesh est prioritaire. Avec AURA_ZERO_COST_MODE=true,
# tout fallback IA distant potentiellement facturable est bloqué dans le code.
AURA_LOCAL_AI_PREFERRED=true
# Modes: off | bridge | gemini | openai_compatible | ollama
AI_MODE=off
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_MS=45000
AI_TEMPERATURE=0.65

# AURA 2.2 — fédération Cloud 0 €.
# OpenRouter "openrouter/free" route uniquement vers les variantes gratuites.
# Une clé est nécessaire, mais aucun modèle payant n'est accepté par le code.
AURA_FREE_FEDERATION_ENABLED=true
AURA_FREE_FEDERATION_TIMEOUT_MS=45000
# Le plan Free OpenRouter annonce 50 requêtes/jour : AURA garde une marge.
AURA_FREE_FEDERATION_MAX_REQUESTS_PER_DAY=45
AURA_FREE_FEDERATION_DISCOVER_MODELS=true
AURA_FREE_FEDERATION_CATALOG_TTL_SECONDS=900
AURA_FREE_FEDERATION_MAX_CATALOG_MODELS=24
AURA_FREE_FEDERATION_EXPLORATION=0.12
AURA_OPENROUTER_API_KEY=
AURA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AURA_OPENROUTER_FREE_MODELS=openrouter/free

# Soul / cognition
AURA_COGNITIVE_ENABLED=true
AURA_COGNITIVE_TICK_SECONDS=30
AURA_COGNITIVE_REFLECTION_SECONDS=300
AURA_COGNITIVE_MAX_REFLECTIONS_PER_HOUR=6

# Curiosity Engine — questions système/Web/interlocuteur en continu.
AURA_CURIOSITY_ENABLED=true
AURA_CURIOSITY_TICK_SECONDS=180
AURA_CURIOSITY_WARMUP_SECONDS=45
AURA_CURIOSITY_QUESTIONS_PER_CYCLE=4
AURA_CURIOSITY_RESEARCH_PER_CYCLE=2
AURA_CURIOSITY_MAX_QUESTIONS_PER_HOUR=16
AURA_CURIOSITY_MAX_WEB_RESEARCH_PER_HOUR=6
AURA_CURIOSITY_MAX_INTERLOCUTOR_QUESTIONS_PER_HOUR=4
AURA_CURIOSITY_PRODUCT_STALE_SECONDS=900

# Centre de commande autonome Quantic Sillage.
# AURA prend des initiatives sans prompt, dans une enveloppe d'actions explicite.
AURA_COMMAND_CENTER_ENABLED=true
AURA_COMMAND_CENTER_AUTO_EXECUTE=true
AURA_DIRECTOR_MODE_ENABLED=true
AURA_DIRECTOR_PORTFOLIO_INTERVAL_HOURS=6
AURA_DIRECTOR_AUTO_MERGE_LOW_RISK=true
AURA_DIRECTOR_PROMOTION_POLL_SECONDS=300
AURA_DIRECTOR_MERGE_MAX_FILES=4
AURA_DIRECTOR_MERGE_MAX_CHANGES=800
AURA_DIRECTOR_TRUSTED_GITHUB_ACTORS=XDSawyerLoL
AURA_COMMAND_CENTER_TICK_SECONDS=60
AURA_COMMAND_CENTER_WARMUP_SECONDS=20
AURA_COMMAND_CENTER_MAX_INITIATIVES_PER_HOUR=8
AURA_COMMAND_CENTER_COOLDOWN_SECONDS=900
AURA_COMMAND_CENTER_MIN_CONFIDENCE=0.58
AURA_COMMAND_CENTER_ALLOWED_RISKS=safe,ai,network,process,local-control,local-write,browser-control

# Missions longues: AURA conserve un objectif, le découpe, agit, critique le résultat et replanifie.
AURA_LONG_HORIZON_ENABLED=true
AURA_LONG_HORIZON_AUTO_SEED=true
AURA_LONG_HORIZON_MIN_PRIORITY=0.72
AURA_LONG_HORIZON_MAX_STEPS=8
AURA_LONG_HORIZON_MAX_REVISIONS=4
AURA_LONG_HORIZON_STEP_MAX_ATTEMPTS=2
AURA_LONG_HORIZON_RESEED_HOURS=24
AURA_COMMAND_CENTER_FLEET_POLL_SECONDS=1200
AURA_COMMAND_CENTER_REQUEST_TIMEOUT_MS=9000
# Jeton machine GitHub optionnel mais nécessaire pour relancer un CI ou ouvrir un ticket.
# Sans jeton, AURA surveille les dépôts publics et planifie, mais n'écrit pas sur GitHub.
AURA_COMMAND_GITHUB_TOKEN=
AURA_COMMAND_GITHUB_REPOS=XDSawyerLoL/Auralive,XDSawyerLoL/QuanticSillage,XDSawyerLoL/QuanticMail,XDSawyerLoL/QUANTIC-OS,XDSawyerLoL/Quantic-Browser,XDSawyerLoL/Human-Agency-Engine
AURA_COMMAND_AUTO_RERUN_FAILED_CI=true
AURA_COMMAND_AUTO_CREATE_FAILURE_ISSUE=true
AURA_COMMAND_MAX_GITHUB_ACTIONS_PER_CYCLE=3

# Expert Bridge — AURA peut demander seule un second avis technique lorsqu'elle bloque.
# OPENAI_API_KEY peut être utilisé à la place de AURA_EXPERT_API_KEY.
# Sans clé externe, AURA retombe sur son IA interne si AURA_EXPERT_INTERNAL_FALLBACK=true.
AURA_EXPERT_BRIDGE_ENABLED=true
AURA_EXPERT_BASE_URL=https://api.openai.com/v1
AURA_EXPERT_API_KEY=
AURA_EXPERT_MODEL=gpt-6-astra
AURA_EXPERT_TIMEOUT_MS=60000
AURA_EXPERT_MAX_CALLS_PER_HOUR=4
AURA_EXPERT_MAX_ROUNDS_PER_INCIDENT=3
AURA_EXPERT_COOLDOWN_SECONDS=900
AURA_EXPERT_MIN_CONFIDENCE=0.68
AURA_EXPERT_INTERNAL_FALLBACK=true
# Désactivé par défaut: le dossier d'incident suffit généralement; activer si une recherche externe est nécessaire.
AURA_EXPERT_WEB_SEARCH_ENABLED=false

# Pont AURA Runtime. Il peut réutiliser AURA_CLOUD_TOKEN côté machine,
# sans exposer ce secret dans l'interface publique.
AURA_BRIDGE_LEASE_SECONDS=90
AURA_BRIDGE_WORKER_ONLINE_MS=45000
AURA_BRIDGE_OPERATOR_WAIT_MS=18000
AURA_BRIDGE_INFERENCE_TIMEOUT_MS=90000
AURA_BRIDGE_VOICE_TIMEOUT_MS=60000
AURA_BRIDGE_IMAGE_TIMEOUT_MS=300000
AURA_BRIDGE_OPERATOR_MAX_STEPS=6


# Web Substrate / méta-raisonnement.
# Sans moteur de recherche externe, AURA dispose déjà des API Wikipedia + Crossref.
# Pour le Web général, brancher un endpoint SearXNG JSON compatible.
AURA_WEB_SUBSTRATE_ENABLED=true
AURA_WEB_SEARCH_URL=
AURA_WEB_SEARCH_API_KEY=
AURA_WEB_SEARCH_LANGUAGE=fr-FR
AURA_WEB_SEARCH_RESULTS=8
AURA_WEB_MAX_QUERIES=3
AURA_WEB_MAX_SOURCES=8
AURA_WEB_MAX_SOURCE_BYTES=240000
AURA_WEB_REQUEST_TIMEOUT_MS=12000
AURA_WEB_MEMORY_TTL_SECONDS=604800
# Vide = Web public HTTPS autorisé, avec blocage SSRF des réseaux privés.
AURA_WEB_ALLOWED_DOMAINS=
AURA_WEB_BLOCKED_DOMAINS=localhost,metadata.google.internal,169.254.169.254

# AURA Fabric 2.0 — Internet comme bus de capacités typées.
AURA_FABRIC_ENABLED=true
# Exemples: https://aura-edge.example.workers.dev
AURA_FABRIC_DISCOVERY_URLS=
AURA_FABRIC_TOKEN=
AURA_FABRIC_REQUEST_TIMEOUT_MS=15000
AURA_FABRIC_DISCOVERY_SECONDS=900
AURA_FABRIC_MAX_REMOTE_CAPABILITIES=64
AURA_FABRIC_REMOTE_TRUST_CEILING=0.78
AURA_FABRIC_MAX_GRAPH_NODES=32
AURA_FABRIC_MAX_PARALLEL=12
# 0 = pas de plafond monétaire tant que les capabilities déclarent coût=0.
AURA_FABRIC_DEFAULT_BUDGET_MICROUNITS=0

# AURA Video Factory — MoneyPrinterTurbo-compatible remote/self-hosted workflow.
AURA_VIDEO_FACTORY_ENABLED=false
AURA_VIDEO_FACTORY_BASE_URL=
AURA_VIDEO_FACTORY_API_KEY=
AURA_VIDEO_FACTORY_TIMEOUT_MS=120000
AURA_VIDEO_FACTORY_ZERO_COST_CONFIRMED=false

# HORIZON
HORIZON_ENABLED=false
HORIZON_BASE_URL=
HORIZON_API_KEY=
HORIZON_EXTERNAL_ID=aura-cloud
HORIZON_POLL_SECONDS=60
HORIZON_COUNTRY=FR
HORIZON_CURRENCY=EUR
HORIZON_TIMEZONE=Europe/Paris

# Evolution autonome Phase 3
AURA_EVOLUTION_ENABLED=true
AURA_EVOLUTION_INTERVAL_SECONDS=21600
AURA_EVOLUTION_GITHUB_REPOSITORY=XDSawyerLoL/Auralive
AURA_EVOLUTION_GITHUB_BASE_BRANCH=main
AURA_EVOLUTION_ALLOWED_DOMAINS=api.github.com,registry.npmjs.org
AURA_EVOLUTION_RESEARCH_URLS=
AURA_EVOLUTION_CANARY_REQUIRED=true
AURA_EVOLUTION_CANARY_MODE=automatic
AURA_EVOLUTION_CANARY_MIN_OBSERVATIONS=3

# Voix canonique Mairaiy — profil historique Aura Live 2.0.7.
# Gemini 3.1 Flash TTS Preview + voix prebuilt Aoede. Le code refuse tout
# changement silencieux vers Kokoro, Leda, Windows ou le TTS navigateur.
MAIRAIY_CLOUD_VOICE_ENABLED=true
TTS_API_KEY=
TTS_BASE_URL=https://generativelanguage.googleapis.com/v1beta
TTS_MODEL=gemini-3.1-flash-tts-preview
TTS_VOICE=Aoede
TTS_TIMEOUT_MS=35000
# Voice Fabric optionnel uniquement pour un futur service qui expose réellement
# le profil Mairaiy/Aoede. Le service Providence actuel est Kokoro ff_siwis et
# n'est donc plus utilisé comme voix canonique.
AURA_VOICE_FABRIC_ENABLED=false
AURA_VOICE_FABRIC_PIN_QUANTIC_ENDPOINT=false
AURA_VOICE_FABRIC_BASE_URL=
AURA_VOICE_FABRIC_API_KEY=
AURA_VOICE_FABRIC_MODEL=gemini-3.1-flash-tts-preview
AURA_VOICE_FABRIC_TRUSTED_ZERO_COST_ORIGINS=
AURA_MAIRAIY_VOICE_PROFILE_ID=
AURA_MAIRAIY_VOICE_PROFILE_NAME=Mairaiy
AURA_MAIRAIY_REQUIRE_PROFILE=true
AURA_MAIRAIY_LANGUAGE=fr-fr
AURA_MAIRAIY_VOICE_INSTRUCT=
AURA_MAIRAIY_VOICE_SPEED=1
AURA_MAIRAIY_VOICE_SEED=2388
AURA_VOICE_FABRIC_TIMEOUT_MS=90000
AURA_VOICE_FABRIC_DISCOVERY_TTL_SECONDS=120
AURA_VOICE_FABRIC_CHUNK_CHARS=3200
AURA_VOICE_FABRIC_MAX_AUDIO_BYTES=20971520
AURA_VOICE_FABRIC_ZERO_COST_CONFIRMED=false
AURA_VOICE_FABRIC_STRICT_IDENTITY=true


# AURA Compute Mesh v0.1 — contrôle cloud
AURA_MESH_MAX_QUORUM=3
AURA_MESH_TIMEOUT_MS=120000
AURA_MESH_MOA_MAX_AGENTS=3


# AURA Peer Mesh v0.2 — signalisation seulement ; le calcul transite pair-à-pair.
AURA_MESH_P2P_ENABLED=true
AURA_MESH_PEER_ONLINE_MS=45000
AURA_MESH_PEER_CLOCK_SKEW_MS=300000
AURA_MESH_P2P_TIMEOUT_MS=45000
# Fallback simple STUN, sans secret.
AURA_MESH_ICE_SERVERS=stun:stun.cloudflare.com:3478
# Pour les NAT stricts, préférer le JSON afin d'ajouter TURN/TURNS avec credentials.
# Exemple uniquement — ne jamais committer de vrais secrets:
# AURA_MESH_ICE_SERVERS_JSON=[{"urls":"stun:stun.cloudflare.com:3478"},{"urls":"turns:turn.example.com:5349","username":"CHANGE_ME","credential":"CHANGE_ME"}]
# all = direct/STUN puis TURN si nécessaire ; relay = forcer TURN.
AURA_MESH_ICE_TRANSPORT_POLICY=all


# AURA bounded cross-product code changes
# Requires AURA_COMMAND_GITHUB_TOKEN with access to the allowlisted repositories.
AURA_COMMAND_AUTO_CREATE_CHANGE_PR=true
AURA_COMMAND_CHANGE_PR_MIN_CONFIDENCE=0.78
AURA_COMMAND_CHANGE_PR_MAX_FILES=4
AURA_COMMAND_CHANGE_PR_MAX_FILE_BYTES=180000
