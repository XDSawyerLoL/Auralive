NODE_ENV=production
HOST=0.0.0.0
PORT=3000
AURA_PUBLIC_BASE_URL=https://antiquewhite-dolphin-780448.hostingersite.com

# MySQL Hostinger
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Alternative: DATABASE_URL=mysql://user:password@localhost:3306/database

# Secrets distincts
AURA_CLOUD_TOKEN=CHANGE_ME_LONG_RANDOM_SECRET
AURA_EVOLUTION_CANARY_TOKEN=CHANGE_ME_DIFFERENT_LONG_RANDOM_SECRET

# IA distante
# Modes: off | gemini | openai_compatible | ollama
# Gemini natif: AI_MODE=gemini + AI_API_KEY suffisent; l'URL et le modèle ont des valeurs par défaut.
AI_MODE=off
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_MS=45000
AI_TEMPERATURE=0.65

# Soul / cognition
AURA_COGNITIVE_ENABLED=true
AURA_COGNITIVE_TICK_SECONDS=30
AURA_COGNITIVE_REFLECTION_SECONDS=300
AURA_COGNITIVE_MAX_REFLECTIONS_PER_HOUR=6

# HORIZON
HORIZON_ENABLED=false
HORIZON_BASE_URL=
HORIZON_API_KEY=
HORIZON_EXTERNAL_ID=aura-cloud
HORIZON_POLL_SECONDS=60
HORIZON_COUNTRY=FR
HORIZON_CURRENCY=EUR
HORIZON_TIMEZONE=Europe/Paris

# Evolution phase 1 Node
AURA_EVOLUTION_ENABLED=true
AURA_EVOLUTION_INTERVAL_SECONDS=21600
AURA_EVOLUTION_GITHUB_REPOSITORY=XDSawyerLoL/Auralive
AURA_EVOLUTION_GITHUB_BASE_BRANCH=main
AURA_EVOLUTION_ALLOWED_DOMAINS=api.github.com,registry.npmjs.org
AURA_EVOLUTION_RESEARCH_URLS=
AURA_EVOLUTION_CANARY_REQUIRED=true
AURA_EVOLUTION_CANARY_MIN_OBSERVATIONS=3
